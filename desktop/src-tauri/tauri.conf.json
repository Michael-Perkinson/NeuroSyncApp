{
"$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroSyncApp",
  "version": "0.1.0",
  "identifier": "nz.co.neurosyncapp.gate0",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
"windows": [{
      "label": "main",
      "title": "NeuroSyncApp · Analyse Raw Data",
      "width": 1440,
      "height": 900,
      "minWidth": 1120,
      "minHeight": 720,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "shortDescription": "NeuroSyncApp raw photometry desktop screen"
  }
}
